# ─── Expo / Frontend ──────────────────────────────────────────────────────────
# Variables prefixed with EXPO_PUBLIC_ are embedded in the client bundle at build time.

# Stripe publishable key (safe to expose in frontend)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Base URL of the deployed app (used for QR links and redirects)
EXPO_PUBLIC_APP_URL=https://qtips-main.vercel.app

# Firebase Cloud Functions base URL (europe-west1 region)
EXPO_PUBLIC_FUNCTIONS_URL=https://europe-west1-qtips-edcc2.cloudfunctions.net

# ─── Firebase Cloud Functions (server-side only) ──────────────────────────────
# Set these via: firebase functions:config:set stripe.secret_key="sk_test_..."
# Or as environment variables in the Firebase console / Google Cloud Run.

# Stripe secret key — NEVER expose in frontend
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (from Stripe dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# QTIPS platform fee percentage (e.g. "2.5" = 2.5%)
QTIPS_FEE_PERCENT=2.5

# Deployed app URL (used for Stripe redirect URLs)
APP_URL=https://qtips-main.vercel.app

# Legacy webhook secret for registerTip endpoint (backward compat)
QTIPS_WEBHOOK_SECRET=change_me_to_random_secret

# ─── Notes ────────────────────────────────────────────────────────────────────
# Firebase client config (apiKey, authDomain, etc.) is intentionally public
# per Firebase design — it is not a secret. Access is controlled by
# Firestore Security Rules (firestore.rules) and Firebase Auth.
#
# Never commit real values to version control.
